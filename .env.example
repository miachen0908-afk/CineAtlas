# Copy to .env.local and fill in your values. Never commit .env.local.

DATABASE_URL="file:./prisma/dev.db"

# Production database (Turso). When set, these take precedence over DATABASE_URL.
# Configure both values in Vercel and never commit the token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required in production to authorize country-history mutations.
HISTORY_EDITOR_SECRET=

TMDB_API_READ_TOKEN=

# Optional: required if TMDB is blocked in your network region
# HTTPS_PROXY=http://127.0.0.1:7890

# Cesium ion — not required for /cesium-prototype phase 1 (local textures only).
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
