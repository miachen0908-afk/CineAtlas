# Copy to .env.local and fill in your values. Never commit .env.local.

# Local SQLite maintenance mode.
DATABASE_URL="file:./prisma/dev.db"

# Optional Turso maintenance database. When set, these take precedence over
# DATABASE_URL. They are only needed by the maintenance version and snapshot job.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password used by the local history editor.
HISTORY_EDITOR_SECRET=

TMDB_API_READ_TOKEN=

# Optional: required if TMDB is blocked in your network region.
# HTTPS_PROXY=http://127.0.0.1:7890

# Cesium ion — not required for /cesium-prototype phase 1 (local textures only).
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
