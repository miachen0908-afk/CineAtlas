{
  "name": "world-cinema-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-cesium": "npx cpx2 \"node_modules/cesium/Build/Cesium/**/*\" public/cesium",
    "posters:atlas": "tsx scripts/generate-poster-atlases.ts",
    "portraits:people": "tsx scripts/import-person-portraits.ts",
    "textures:cesium": "tsx scripts/generate-cesium-globe-textures.ts",
    "predev": "npm run copy-cesium",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run copy-cesium && npm run posters:atlas",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:import": "tsx scripts/import-tmdb.ts",
    "db:import:countries": "tsx scripts/import-tmdb-countries.ts",
    "db:sync:turso": "node --env-file=.env.local scripts/sync-sqlite-to-turso.mjs",
    "db:validate": "tsx scripts/validate-films.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@turf/area": "^7.3.5",
    "@turf/bbox": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/buffer": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "better-sqlite3": "^13.0.1",
    "cesium": "^1.143.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "earcut": "^3.2.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.34.0",
    "next": "16.2.11",
    "ogl": "^1.0.11",
    "polylabel": "^2.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cpx2": "^9.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
