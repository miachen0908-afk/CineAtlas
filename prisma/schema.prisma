generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Film {
  id                       String    @id
  tmdbId                   Int?      @unique
  titleZh                  String
  titleOriginal            String
  year                     Int
  primaryProductionCountry String
  otherProductionCountries Json      @default("[]")
  productionCity           String?
  filmingLocations         Json      @default("[]")
  coordinates              Json
  genreIds                 Json      @default("[]")
  directorIds              Json      @default("[]")
  posterUrl                String?
  posterColor              String?
  summary                  String    @default("")
  rating                   Float?
  likeCount                Int       @default(0)
  importStatus             String    @default("pending")
  importCandidates         Json?
  importError              String?
  dataSource               String?
  importedAt               DateTime?
  updatedAt                DateTime  @updatedAt
}

model CountryCinemaHistoryContent {
  countryCode String   @id
  content     Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  revisions   CountryCinemaHistoryRevision[]
}

model CountryCinemaHistoryRevision {
  id          Int      @id @default(autoincrement())
  countryCode String
  version     Int
  content     Json
  createdAt   DateTime @default(now())
  history     CountryCinemaHistoryContent @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([countryCode, version])
  @@index([countryCode, createdAt])
}
